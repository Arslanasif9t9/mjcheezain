# ============================================================
# PRODUCTION .env TEMPLATE — copy these values into the .env
# file ON THE SERVER (public_html/.env), then run:
#   php artisan config:clear
#   php artisan cache:clear
# ============================================================

APP_NAME="MJ Cheezain"
APP_ENV=production
APP_KEY=            # keep the existing APP_KEY from the server
APP_DEBUG=false     # MUST be false in production (no red error pages)
APP_URL=https://yourdomain.com

LOG_CHANNEL=daily
LOG_LEVEL=error

# ------------------------------------------------------------
# DATABASE — get these from Hosting Panel -> MySQL Databases
# The production database user is NOT "root". On Hostinger it
# looks like: u425346958_xxxx with the password you created.
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u425346958_DB
DB_USERNAME=u425346958_YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail settings (copy real values from your current .env)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
