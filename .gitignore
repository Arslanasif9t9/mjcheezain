# Laravel / PHP default ignore rules
/vendor/
/node_modules/
/public/storage
/public/build
/public/hot
/storage/*.key
/storage/pail/
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/public/*
*.log

# Databases
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Environment files
.env
.env.backup
.env.production

# Claude Code local data (not for push)
/claude-code-data/
/for-claude-code-just/

# IDEs and local configurations
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
/.idea/
/.vscode/
/.zed/
/.fleet/
/.nova/
/.phpunit.cache/
.phpunit.result.cache
.phpactor.json
/auth.json
*.zip